// Cornix-inspired layout for the Eyelash Sofle. See docs/cornix-keymap.md.
// The board transform contains five center slots absent from this keyboard.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };
&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};
&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};
&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";
        previous_tab {
            timeout-ms = <50>;
            key-positions = <34 35>;
            layers = <0>;
            bindings = <&kp LG(LA(LEFT))>;
        };
        next_tab {
            timeout-ms = <50>;
            key-positions = <35 36>;
            layers = <0>;
            bindings = <&kp LG(LA(RIGHT))>;
        };
        previous_desktop {
            timeout-ms = <50>;
            key-positions = <21 22>;
            layers = <0>;
            bindings = <&kp LC(LEFT)>;
        };
        next_desktop {
            timeout-ms = <50>;
            key-positions = <22 23>;
            layers = <0>;
            bindings = <&kp LC(RIGHT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
                &lt 4 GRAVE           &kp N1                &kp N2                &kp N3                &kp N4                &kp N5                &none                 &kp N6                &kp N7                &kp N8                &kp N9                &kp N0                &kp BACKSLASH
                &kp TAB               &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &none                 &kp Y                 &kp U                 &kp I                 &kp O                 &kp P                 &kp BACKSPACE
                &kp CAPS              &kp A                 &kp S                 &kp D                 &kp F                 &kp G                 &none                 &kp H                 &kp J                 &kp K                 &kp L                 &kp SEMI              &mt RALT ENTER
                &kp LSHFT             &kp Z                 &kp X                 &kp C                 &kp V                 &kp B                 &none                 &kp N                 &kp M                 &kp COMMA             &kp DOT               &kp FSLH              &mt RSHFT APOS
                &kp C_MUTE            &kp LCTRL             &kp LGUI              &kp LALT              &mo 3                 &kp ESC               &none                 &kp BACKSPACE         &lt 3 SPACE           &lt 1 BACKSLASH       &mo 2                 &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            display-name = "Shortcuts";
            bindings = <
                &trans                &kp F1                &kp F2                &kp F3                &kp F4                &kp F5                &none                 &kp F6                &kp F7                &kp F8                &kp F9                &kp F10               &trans
                &kp LG(TAB)           &none                 &kp LG(W)             &none                 &kp LG(R)             &kp LG(T)             &none                 &none                 &none                 &kp UP                &none                 &none                 &trans
                &trans                &kp LG(A)             &kp LG(S)             &none                 &kp LG(F)             &none                 &none                 &kp LS(LBKT)          &kp LEFT              &kp DOWN              &kp RIGHT             &trans                &trans
                &trans                &kp LG(Z)             &kp LG(X)             &kp LG(C)             &kp LG(V)             &kp LG(B)             &none                 &kp LS(RBKT)          &none                 &none                 &none                 &trans                &trans
                &none                 &trans                &trans                &trans                &none                 &trans                &none                 &trans                &trans                &trans                &trans                &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            display-name = "Mouse";
            bindings = <
                &trans                &trans                &trans                &trans                &trans                &trans                &none                 &trans                &trans                &trans                &trans                &trans                &trans
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &msc SCRL_UP          &mkp LCLK             &mmv MOVE_UP          &mkp RCLK             &none                 &none
                &bt BT_SEL 0          &none                 &none                 &none                 &none                 &none                 &none                 &msc SCRL_DOWN        &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_RIGHT       &none                 &none
                &bt BT_SEL 1          &none                 &none                 &none                 &none                 &none                 &none                 &none                 &kp LG(LA(LEFT))      &kp LG(LA(RIGHT))     &kp LC(LEFT)          &kp LC(RIGHT)         &none
                &kp C_MUTE            &bt BT_SEL 2          &trans                &trans                &none                 &trans                &none                 &trans                &trans                &trans                &none                 &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Symbols";
            bindings = <
                &trans                &trans                &trans                &trans                &trans                &trans                &none                 &trans                &trans                &trans                &trans                &trans                &trans
                &kp GRAVE             &kp N1                &kp N2                &kp N3                &kp N4                &kp N5                &none                 &kp N6                &kp N7                &kp N8                &kp N9                &kp N0                &trans
                &kp LS(GRAVE)         &kp LS(N1)            &kp LS(N2)            &kp LS(N3)            &kp LS(N4)            &kp LS(N5)            &none                 &kp LS(N6)            &kp LS(N7)            &kp LS(N8)            &kp LS(N9)            &kp LS(N0)            &trans
                &trans                &kp KP_MINUS          &kp KP_PLUS           &kp KP_EQUAL          &kp LS(LBKT)          &kp LS(RBKT)          &none                 &kp LBKT              &kp RBKT              &trans                &trans                &trans                &trans
                &kp C_MUTE            &trans                &trans                &trans                &trans                &trans                &none                 &trans                &trans                &trans                &trans                &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_4 {
            display-name = "System";
            bindings = <
                &trans                &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4          &none                 &kp F6                &kp F7                &kp F8                &kp F9                &kp F10               &kp F12
                &bt BT_CLR            &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &kp F11
                &none                 &out OUT_USB          &out OUT_BLE          &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
                &none                 &sys_reset            &none                 &bootloader           &none                 &none                 &none                 &none                 &none                 &sys_reset            &soft_off             &bootloader           &none
                &kp C_MUTE            &trans                &trans                &trans                &trans                &trans                &none                 &trans                &trans                &trans                &trans                &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
